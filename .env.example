# Database Configuration - Using LiteLLM PostgreSQL
DATABASE_URL=postgresql+asyncpg://litellm_user:litellm_secure_password_change_this@localhost:5432/ragdb

# LiteLLM Proxy Configuration
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=your-litellm-api-key-here
LITELLM_CHAT_MODEL=gemini-2.5-flash
LITELLM_EMBEDDING_MODEL=text-embedding-004

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Vector Search Configuration
DEFAULT_TOP_K=5

# Agent Configuration
CORPUS_ID=your-corpus-id-here
